# Copy this file to backend/.env and add your free Gemini API key
# (create one at https://aistudio.google.com/apikey).
# Without a key the app still works, using its built-in keyword parser.
GEMINI_API_KEY=

# PostgreSQL connection (required). The database is created on first start if it does not
# exist, together with the "student" and "student_history" tables.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/student_reports

# Optional: override the Gemini model.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: port the backend listens on. If you change it, start the frontend
# with BACKEND_URL=http://127.0.0.1:<port> so it forwards to the right place.
# PORT=4000
